# --- Firebase client SDK (public, safe to expose in the browser bundle) ---
# From Firebase Console > Project Settings > General > Your apps > SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server-only, keep secret, used by /api routes) ---
# From Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full PEM key. Keep the surrounding quotes; \n line breaks are handled automatically.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Email notifications (optional) ---
# Powers "someone submitted the contact form" emails and newsletter confirmations.
# Uses Resend (https://resend.com) by default — swap the implementation in
# lib/notifications.ts if you use a different provider. Leaving RESEND_API_KEY unset
# simply disables emails; the contact form and newsletter signup still work and still
# write to Firestore either way.
RESEND_API_KEY=
# Must be a verified sending domain/address in your Resend account.
CONTACT_NOTIFICATION_FROM=
# Defaults to the email in lib/site-data.ts if unset.
CONTACT_NOTIFICATION_TO=

# --- AI chat widget (optional) ---
# Powers the "Ask about my work" floating chat widget (components/ChatWidget.tsx),
# grounded entirely in lib/site-data.ts content via lib/chat-context.ts — it won't
# invent pricing, availability, or claims that aren't already on the site.
# Get a key from https://console.anthropic.com. Leaving this unset means the widget
# stays hidden (see NEXT_PUBLIC_CHAT_ENABLED) and /api/chat returns a graceful
# "not configured" message rather than erroring.
ANTHROPIC_API_KEY=
# Must be exactly "true" to show the widget. Keep it unset/false until
# ANTHROPIC_API_KEY is actually set, so visitors don't see a chat bubble that
# can't respond yet.
NEXT_PUBLIC_CHAT_ENABLED=false

# --- GitHub contribution graph (optional) ---
# Powers the "Recent Activity" section on the About page (lib/github.ts). Uses
# GitHub's GraphQL API, which requires a token even for public contribution data.
# A token with NO scopes selected (classic) or no permissions (fine-grained) is
# enough — this only reads public activity. Get one at
# https://github.com/settings/tokens. Leaving this unset simply omits the section.
GITHUB_TOKEN=

# --- Dashboard admin access (required for /dashboard/inquiries) ---
# Comma-separated list of email addresses allowed to read contact-form inquiries
# and newsletter subscribers via /api/dashboard/inquiries. Anyone can sign up at
# /sign-up, but that alone does NOT grant access to this data — the signed-in
# account's email must also appear here. Example:
# ADMIN_EMAILS=jamesmaruti560@gmail.com
ADMIN_EMAILS=

# --- Error monitoring (optional) ---
# Powers Sentry error reporting (sentry.client.config.ts, sentry.server.config.ts,
# sentry.edge.config.ts). Get a DSN from https://sentry.io -- a new Next.js project
# there gives you both values below. Leaving these unset means Sentry.init() runs
# as a documented no-op; nothing breaks, errors just aren't reported anywhere.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Only needed if you want source maps uploaded on build (better stack traces in
# the Sentry dashboard). Get one from Sentry -> Settings -> Auth Tokens. Leave
# blank to skip source map upload entirely -- the build works fine either way.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
