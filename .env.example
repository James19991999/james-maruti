# --- Firebase client SDK (public, safe to expose in the browser bundle) ---
# From Firebase Console > Project Settings > General > Your apps > SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server-only, keep secret, used by /api routes) ---
# From Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full PEM key. Keep the surrounding quotes; \n line breaks are handled automatically.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Email notifications (optional) ---
# Powers "someone submitted the contact form" emails and newsletter confirmations.
# Uses Resend (https://resend.com) by default — swap the implementation in
# lib/notifications.ts if you use a different provider. Leaving RESEND_API_KEY unset
# simply disables emails; the contact form and newsletter signup still work and still
# write to Firestore either way.
RESEND_API_KEY=
# Must be a verified sending domain/address in your Resend account.
CONTACT_NOTIFICATION_FROM=
# Defaults to the email in lib/site-data.ts if unset.
CONTACT_NOTIFICATION_TO=
