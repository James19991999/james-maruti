rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Authenticated users may read/write only their own profile document.
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Contact inquiries and newsletter signups are written exclusively by the
    // server (via /api/contact and /api/newsletter using the Admin SDK, which
    // bypasses these rules). Deny all direct client access -- reading this
    // data (e.g. for the dashboard's Inquiries view) also goes through the
    // Admin SDK, via /api/dashboard/inquiries, gated by requireAdmin() in
    // lib/firebase-admin.ts (ID token verification + an ADMIN_EMAILS
    // allowlist), not through these rules.
    match /inquiries/{docId} {
      allow read, write: if false;
    }

    match /newsletter_subscribers/{docId} {
      allow read, write: if false;
    }

    // Rate-limit counters written by the Admin SDK from API routes only.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
